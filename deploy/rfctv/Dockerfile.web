# RFC Legends web app for the rfctv box (D2).
# Build context: apps/web  (dockerfile path is passed by compose).
# The production env file is copied in ONLY for the builder stage, so
# NEXT_PUBLIC_* values are baked into the client bundle; the final image
# does not contain it — runtime secrets come from compose `env_file`.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN test -f .env.production.local || (echo "missing .env.production.local in build context" && exit 1)
RUN npx next build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
RUN rm -f .env.production.local
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
