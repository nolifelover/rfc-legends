# Copy to apps/web/.env.local (gitignored). Never commit real keys.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=
APP_URL=http://localhost:3000

# Game server key: signs mint vouchers, calls HumanRegistry.markVerified
GAME_SIGNER_PRIVATE_KEY=
MINT_DAILY_LIMIT=3
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# World ID (IDKit 4) from developer.world.org
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=mint-rare-drop
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# production (real World App) or staging (simulator; also needs the token below)
WORLD_ENVIRONMENT=production
WORLD_STAGING_VERIFICATION_TOKEN=
WORLD_VERIFY_BASE_URL=https://developer.world.org

# ENSv2 pedigree
NEXT_PUBLIC_ENS_PARENT_NAME=
FARM_SIGNER_PRIVATE_KEY=

# Curvegrid MultiBaas
MULTIBAAS_DEPLOYMENT_URL=
MULTIBAAS_API_KEY=

# PocketBase (players, drops, World ID nullifiers, guild chat) — see pocketbase/README.md
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
