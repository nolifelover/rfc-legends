# RFC Legends web app for the rfctv box (D2).
# Runtime-only image: the app is PREBUILT locally by scripts/deploy.sh
# (scripts/deploy-rfctv.sh ships the built stage here). We deliberately do
# not run `next build` in this image: a Turbopack pass on the box dropped
# human-readable ABI string literals from the executable chunks (verified:
# "function getRooster" present in the local build's .js, absent from the
# box-built .js), which silently broke every viem contract read. One build,
# shipped everywhere, avoids that class of nondeterminism entirely.
# NEXT_PUBLIC_* values are already baked by the local build; runtime secrets
# come from compose `env_file`.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY . .
RUN rm -f .env.production.local
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
